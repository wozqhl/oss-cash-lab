{
  "name": "@oss-cash-lab/sdk-mcp-gen",
  "version": "0.1.0",
  "description": "OpenAPI to multi-lang SDK + stdio MCP server generator (TS + Python + Go + Java + Rust + C# + Kotlin + Swift + Ruby + PHP)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sdk-mcp-gen": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "smoke": "node src/cli.js smoke",
    "local-mvp": "bash scripts/local-mvp.sh",
    "generate:petstore": "node src/cli.js generate examples/petstore.openapi.json --out out/petstore",
    "version": "node src/cli.js --version",
    "check": "node src/cli.js check",
    "generate:petstore:check": "node src/cli.js generate examples/petstore.openapi.json --out out/petstore --check-baseline out/petstore"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wozqhl/oss-cash-lab.git",
    "directory": "bets/a-sdk-mcp-gen"
  },
  "bugs": {
    "url": "https://github.com/wozqhl/oss-cash-lab/issues"
  },
  "homepage": "https://github.com/wozqhl/oss-cash-lab/tree/main/bets/a-sdk-mcp-gen",
  "files": [
    "src",
    "examples",
    "action.yml",
    "README.md",
    "PUBLISH.md",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "openapi",
    "sdk",
    "mcp",
    "generator",
    "model-context-protocol",
    "typescript",
    "python",
    "go"
  ]
}
